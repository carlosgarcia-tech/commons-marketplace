# Rendered by the nginx image entrypoint: envsubst over
# /etc/nginx/templates/*.template using the container's environment.
# UPSTREAM_HOST / UPSTREAM_PORT select the backend target:
#   - compose development: the 'app' service (see docker-compose.yml)
#   - blue-green servers: a commons-marketplace-<color> container, or the
#     commons-deploy reverse proxy itself.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream marketplace_backend {
    server ${UPSTREAM_HOST}:${UPSTREAM_PORT};
}

server {
    listen 443 ssl;
    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;

    # app parses JSON bodies up to 10mb; nginx defaults to 1m
    client_max_body_size 12m;

    location / {
        proxy_pass http://marketplace_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket upgrades (chat/realtime endpoints)
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout          300s;
        proxy_send_timeout          300s;
    }
}
