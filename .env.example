# ============================================
# commons-marketplace — variables de entorno
# Copia este fichero a .env y rellena los valores
# ============================================

# --- Obligatorias (validateEnvironment: el server no arranca sin estas) ---
NODE_ENV=development
PORT=3000

# --- MongoDB Atlas (cuenta gratuita: https://www.mongodb.com/atlas) ---
# Añade tu IP actual en Atlas > Network Access > IP Access List o el
# handshake TLS será rechazado ('tlsv1 alert internal error').
# Escapa caracteres especiales de la password: @=%40 :=%3A
DB_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/CommonMarketplaceServiceDB?retryWrites=true&w=majority

# --- MongoDB local opcional (docker-compose up -d mongodb) ---
# DB_URL=mongodb://admin:changeme@localhost:27017/CommonMarketplaceServiceDB?authSource=admin
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
DB_NAME=CommonMarketplaceServiceDB
DB_PORT=27017

# --- Supabase (Dashboard > Settings > API) ---
SUPABASE_URL=https://xxxxx.supabase.co
# sb_publishable_... para operaciones públicas, sb_secret_... para admin.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_STORAGE_BUCKET=CommonMarketplace

# --- Ably (Dashboard > App settings > API keys, formato key:secret) ---
ABLY_API_KEY=xxxxxxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxx

# --- URLs y CORS (solo backend, sin front) ---
API_URL=http://localhost:3000
SOCKET_URL=http://localhost:3000
# Saltos de proxy inverso delante de la API (1 = nginx). Sin proxy: false.
TRUST_PROXY=false
# Orígenes permitidos, separados por coma.
CORS_ORIGINS=http://localhost:3000

# --- Push notifications Web Push (VAPID keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@example.com

# --- Logging (por defecto ./logs y level según NODE_ENV) ---
LOG_DIR=
LOG_LEVEL=

# --- Tests (integration) ---
TEST_BASE_URL=http://localhost:3000
