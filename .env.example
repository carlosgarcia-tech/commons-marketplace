NODE_ENV=development
PORT=5000
DB_URL=mongodb://admin:changeme@mongodb:27017/CommonMarketplaceServiceDB?authSource=admin

# Root credentials for the MongoDB container (docker-compose production/staging).
# DB_URL must use the same user/password with authSource=admin.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
SUPABASE_URL=https://.supabase.co
# Current Supabase API keys (Dashboard > Settings > API).
# sb_publishable_... for public operations, sb_secret_... for admin operations.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
SUPABASE_STORAGE_BUCKET=
ABLY_API_KEY=.:
# Number of reverse proxy hops in front of the API (nginx). Used for
# req.ip resolution so rate limiting works per real client. Set to 'false'
# when running without a proxy.
TRUST_PROXY=1
# CORS: when the client is served from another origin (e.g. the
# commons-deploy blue-green stack on commons-net), list that origin here,
# comma-separated - the browser blocks every API call otherwise.
CORS_ORIGINS=http://localhost:4000