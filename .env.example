NODE_ENV=development
PORT=5000
DB_URL=mongodb://admin:changeme@mongodb:27017/CommonMarketplaceServiceDB?authSource=admin

# Root credentials for the MongoDB container (docker-compose production/staging).
# DB_URL must use the same user/password with authSource=admin.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
SUPABASE_URL=https://.supabase.co
SUPABASE_ANON_KEY=..
SUPABASE_SERVICE_ROLE_KEY=..z-qbG--
SUPABASE_STORAGE_BUCKET=
ABLY_API_KEY=.:
# Number of reverse proxy hops in front of the API (nginx). Used for
# req.ip resolution so rate limiting works per real client. Set to 'false'
# when running without a proxy.
TRUST_PROXY=1